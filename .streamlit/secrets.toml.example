# ============================================================
# MongoDB Secrets Configuration Template
# ============================================================
# Copy this file to .streamlit/secrets.toml and fill in your
# MongoDB Atlas connection string.
#
# For Streamlit Community Cloud:
#   Go to App Settings → Secrets and paste the contents below.
#
# Get a FREE MongoDB Atlas cluster at: https://cloud.mongodb.com
# ============================================================

[mongo]
uri = "mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority&appName=ChurnShield"
db_name = "churnshield"
collection_name = "predictions"
